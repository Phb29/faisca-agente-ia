# Copie para .env e preencha. Nenhuma chave é necessária para rodar os testes.

# Infra (o docker-compose já aponta para estes valores)
DATABASE_URL=postgresql://ampere:ampere@localhost:5432/ampere
QDRANT_URL=http://localhost:6333

# Modelos (ver docs/adr/0002). Deixe MODELOS_FALSOS=true para rodar sem chave alguma.
MODELOS_FALSOS=false
OPENAI_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=
MODELO_GERADOR=gpt-5.6-terra
MODELO_JUIZ=gpt-5.6-sol
MODELO_TRABALHADOR=openai/gpt-oss-120b

# Observabilidade (Langfuse Cloud). Sem chaves, o tracing é desligado.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# RAG (ver docs/adr/0003). O nome da coleção é derivado de EMBEDDER e CHUNKER.
EMBEDDER=minilm            # minilm | openai
CHUNKER=markdown           # recursivo | markdown | semantico
RERANKER=colbert           # colbert | nenhum
SELF_QUERYING=true
MINIMO_CANDIDATOS_FILTRADOS=3

# Guardrails, Roteador e Gate de Aprovação (probabilidades do Jev, de 0 a 1)
LIMIAR_GUARDRAIL_ENTRADA=0.7
LIMIAR_GUARDRAIL_SAIDA=0.7
LIMIAR_GATE_APROVACAO=0.5
VALOR_LIMITE_REEMBOLSO=300

# Memória de Curto Prazo: acima deste número de mensagens, as antigas viram resumo
LIMITE_MENSAGENS_RESUMO=20

# Tela do Atendente
ATENDENTE_TOKEN=atendente-secreto

# Front
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
