# Copie para .env (na raiz do repositório) e preencha. Nunca faça commit do .env.
# Nenhuma chave é necessária para rodar os testes nem o modo demonstração (MODELOS_FALSOS=true).
# Os comandos `ampere` leem este arquivo da pasta onde rodam: rode da raiz, com
# `uv run --project backend ampere ...` (ver o README).

# Infra. O compose expõe o Postgres na 5439 para não colidir com um Postgres local na 5432.
DATABASE_URL=postgresql://ampere:ampere@localhost:5439/ampere
QDRANT_URL=http://localhost:6333
# Origens que podem chamar a API pelo navegador (JSON). O navegador só fala com o frontend,
# então isto quase não importa no local; em produção, use só o domínio do frontend.
ORIGENS_PERMITIDAS=["*"]

# Modelos (ver docs/adr/0002). MODELOS_FALSOS=true liga o modo demonstração: sem chave alguma,
# dublês reagem à mensagem por palavras-chave (rode o ingest no mesmo modo).
MODELOS_FALSOS=false
# Com MODELOS_FALSOS=false, as três são obrigatórias (com os provedores padrão abaixo):
# OpenAI (gerador e juiz): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Groq (trabalhador): https://console.groq.com/keys. Sem ela, use PROVEDOR_TRABALHADOR=openai
# e um modelo da OpenAI em MODELO_TRABALHADOR.
GROQ_API_KEY=
# TypeSafe (o Jev, que decide Guardrails, Roteador e Gate): https://typesafe.ai
TYPESAFE_API_KEY=
# Cada papel tem um provedor e um modelo; trocar de provedor é só mudar aqui (ver docs/adr/0008)
PROVEDOR_GERADOR=openai        # openai | groq
MODELO_GERADOR=gpt-6-luna
PROVEDOR_JUIZ=openai           # openai | groq
MODELO_JUIZ=gpt-6.1-sol
PROVEDOR_TRABALHADOR=groq      # openai | groq
MODELO_TRABALHADOR=openai/gpt-oss-120b

# Observabilidade (Langfuse Cloud, opcional). Sem chaves, o tracing é desligado e o resto
# funciona igual. Chaves em https://cloud.langfuse.com (Settings > API Keys do projeto).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# RAG (ver docs/adr/0003). O nome da coleção é derivado de EMBEDDER e CHUNKER.
EMBEDDER=minilm            # minilm | openai
CHUNKER=markdown           # recursivo | markdown | semantico
RERANKER=colbert           # colbert | nenhum
SELF_QUERYING=true
MINIMO_CANDIDATOS_FILTRADOS=3

# Guardrails e Gate de Aprovação: probabilidades do Jev, de 0 a 1, a partir das quais uma
# regra dispara. O texto das regras está em backend/ampere/regras/*.yaml.
LIMIAR_GUARDRAIL_ENTRADA=0.7
LIMIAR_DADO_SENSIVEL=0.5
LIMIAR_GUARDRAIL_SAIDA=0.7
LIMIAR_GATE_APROVACAO=0.5
# Política de Reembolso: acima do valor, ou com outro Reembolso na janela, sempre há Atendente
VALOR_LIMITE_REEMBOLSO=300
JANELA_REEMBOLSO_RECENTE_DIAS=30

# Streaming e Guardrail de saída: true mostra a resposta sendo escrita antes de o Guardrail
# aprovar (o front apaga o rascunho se ela for reprovada); false segura os tokens até a
# aprovação, e nenhum texto reprovado chega ao navegador.
TOKENS_ANTES_DO_GUARDRAIL=true

# Memória de Curto Prazo: acima deste número de mensagens, as antigas viram resumo
LIMITE_MENSAGENS_RESUMO=20

# Login do chat, da Central e da Avaliação: uma conta só. Sem os dois, ninguém entra.
# O hash sai de `uv run --project backend ampere hash-senha` (a senha em si não fica aqui).
# Exemplo: LOGIN_EMAIL=voce@exemplo.com
LOGIN_EMAIL=
LOGIN_SENHA_HASH=
SESSAO_HORAS=12

# Segredo que o frontend manda em toda chamada à api (X-Bff-Segredo). Vazio desliga a
# conferência, o que serve no local. Em produção é obrigatório: gere com
# `openssl rand -base64 32` e ponha o MESMO valor no frontend (frontend/.env.local, ou a
# variável do serviço). O docker compose repassa este valor ao frontend sozinho.
BFF_SEGREDO=

# O frontend tem o próprio arquivo de variáveis: ver frontend/.env.example.
